{
  "name": "task-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Task Planner Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend/task-planner-frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend/task-planner-frontend",
    "init-db": "npm run init-db --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

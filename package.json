{
  "name": "task-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Task Planner Application",
  "scripts": {
    "build": "npm --prefix frontend/task-planner-frontend install && npm --prefix frontend/task-planner-frontend run build && node -e \"require('fs').cpSync('frontend/task-planner-frontend/dist', 'dist', {recursive: true})\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend/task-planner-frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "npm start --prefix backend",
    "init-db": "npm run init-db --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

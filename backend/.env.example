# ==============================================================================
# Task Planner Backend Configuration Template
# ==============================================================================

PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here
SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Local or Cloud)
# ------------------------------------------------------------------------------
# Option A: Cloud MySQL Connection URI (e.g. TiDB Cloud, Railway, Aiven)
# DATABASE_URL=mysql://username:password@gateway.tidbcloud.com:4000/task_planner2?ssl={"rejectUnauthorized":true}

# Option B: Standard Local Variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_planner2
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. SMTP EMAIL CONFIGURATION (Optional - for live email dispatch)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Task Planner" <no-reply@taskplanner.io>
